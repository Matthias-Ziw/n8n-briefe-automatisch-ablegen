      "parameters": {
        "method": "POST",
        "url": "={{ $('Einstellungen').first().json.ollama_url }}/api/chat",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"{{ $('Einstellungen').first().json.modell }}\",\n  \"stream\": false,\n  \"keep_alive\": \"10m\",\n  \"options\": { \"temperature\": 0, \"num_ctx\": 8192 },\n  \"format\": {\"type\": \"object\", \"properties\": {\"person\": {\"type\": \"string\", \"enum\": [\"Max\", \"Erika\", \"Gemeinsam\"]}, \"kategorie\": {\"type\": \"string\", \"enum\": [\"Finanzen & Bank\", \"Versicherungen\", \"Steuern\", \"Wohnen & Nebenkosten\", \"Verträge & Abos\", \"Gesundheit\", \"Auto & Mobilität\", \"Arbeit & Gehalt\", \"Behörden\", \"Rechnungen & Kaufbelege\", \"Sonstiges\"]}, \"absender\": {\"type\": \"string\"}, \"datum\": {\"type\": \"string\"}, \"titel\": {\"type\": \"string\"}, \"sicher\": {\"type\": \"boolean\"}}, \"required\": [\"person\", \"kategorie\", \"absender\", \"datum\", \"titel\", \"sicher\"]},\n  \"messages\": [\n    { \"role\": \"system\", \"content\": {{ JSON.stringify($('Einstellungen').first().json.anweisung) }} },\n    { \"role\": \"user\", \"content\": {{ JSON.stringify(\"Titel in Paperless: \" + $json.title + \"\\n\\nText:\\n\" + ($json.content || \"\").slice(0, 6000)) }} }\n  ]\n}",
        "options": {
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 0
            }
          },
          "timeout": 600000
        }
      },
